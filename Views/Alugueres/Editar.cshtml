@model Mod5_CRUD.Models.AlugueresModel

@{
    ViewData["Title"] = "Editar Aluguer";
}

<div class="container bg-dark p-5 rounded-5">
    <div class="mb-5 text-center text-light">
        <h1>Editar Aluguer</h1>
    </div>

    <form method="post" asp-controller="Alugueres" asp-action="Editar">
        <input type="hidden" asp-for="Id" />

        <div class="form-group text-light">
            <label for="Cliente">Cliente</label>
            <input type="text" class="form-control" asp-for="Cliente" placeholder="Cliente do Aluguer">
            <span asp-validation-for="Cliente" class="text-danger"></span>
        </div>

        <div class="form-group text-light">
            <label for="Vendedor">Vendedor</label>
            <input type="text" class="form-control" asp-for="Vendedor" placeholder="Vendedor do Aluguer">
            <span asp-validation-for="Vendedor" class="text-danger"></span>
        </div>

        <div class="form-group text-light">
            <label for="Veiculo">Veículo</label>
            <input type="text" class="form-control" asp-for="Veiculo" placeholder="Veículo do Aluguer">
            <span asp-validation-for="Veiculo" class="text-danger"></span>
        </div>

        <div class="form-group text-light">
            <label for="DataAluguer">Data do Aluguer</label>
            <input type="date" class="form-control" asp-for="DataAluguer">
            <span asp-validation-for="DataAluguer" class="text-danger"></span>
        </div>

        <div class="d-flex gap-5 mt-5">
            <button type="submit" class="btn btn-warning w-50">Salvar Alterações</button>
            <a asp-controller="Alugueres" asp-action="Index" class="btn btn-primary w-50">Voltar</a>
        </div>
    </form>
</div>