@model IEnumerable<Mod5_CRUD.Models.AlugueresModel>

@{
    ViewData["Title"] = "Alugueres";
}

@if (TempData["Mensagem"] != null)
{
    if (TempData["TipoMensagem"]?.ToString() == "success")
    {
        <div class="alert alert-success text-light" role="alert">
            @TempData["Mensagem"]
        </div>
    }
    else if (TempData["TipoMensagem"]?.ToString() == "danger")
    {
        <div class="alert alert-danger text-light" role="alert">
            @TempData["Mensagem"]
        </div>
    }
}

<div class="d-flex justify-content-between align-items-center bg-dark text-light p-3 rounded" style="margin-bottom: 0 !important;">
    <h1 class="text-light m-0">Alugueres</h1>
    <div class="d-flex gap-3">
        <form class="d-flex" asp-controller="Alugueres" asp-action="Index" method="get">
            <input class="form-control me-2 bg-secondary text-white border-0"
                   type="search"
                   name="pesquisa"
                   value="@Context.Request.Query["pesquisa"]"
                   placeholder="Pesquisar por cliente, vendedor ou veículo..."
                   style="min-width: 300px;">
            <button class="btn btn-success px-4" type="submit">🔍</button>
        </form>
        <a class="btn btn-success" asp-controller="Alugueres" asp-action="Cadastrar">CADASTRO DE ALUGUERES</a>
    </div>
</div>

<table class="table table-dark table-hover table-bordered" style="margin-top: 0 !important;">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Cliente</th>
            <th scope="col">Vendedor</th>
            <th scope="col">Veículo</th>
            <th scope="col">Data do Aluguer</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var aluguer in Model)
            {
                <tr>
                    <td>@aluguer.Id</td>
                    <td><strong>@aluguer.Cliente</strong></td>
                    <td>@aluguer.Vendedor</td>
                    <td>@aluguer.Veiculo</td>
                    <td>@aluguer.DataAluguer.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a class="btn btn-warning btn-sm mx-1" 
                           asp-controller="Alugueres" 
                           asp-action="Editar" 
                           asp-route-id="@aluguer.Id">EDITAR</a>
                        <a class="btn btn-danger btn-sm mx-1" 
                           onclick="confirmarExclusao(@aluguer.Id, '@aluguer.Cliente')">EXCLUIR</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">Nenhum aluguer encontrado.</td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPaginas > 1)
{
    <nav aria-label="Paginação dos alugueres">
        <ul class="pagination justify-content-center mt-4">
            @if (ViewBag.PaginaAtual > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pagina="@(ViewBag.PaginaAtual - 1)" 
                       asp-route-pesquisa="@ViewBag.Pesquisa">Anterior</a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaAtual ? "active" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pagina="@i" 
                       asp-route-pesquisa="@ViewBag.Pesquisa">@i</a>
                </li>
            }

            @if (ViewBag.PaginaAtual < ViewBag.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pagina="@(ViewBag.PaginaAtual + 1)" 
                       asp-route-pesquisa="@ViewBag.Pesquisa">Próxima</a>
                </li>
            }
        </ul>
    </nav>
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
